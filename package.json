{
  "name": "trace2test",
  "version": "0.2.1",
  "description": "Turn production LLM failures into portable regression tests.",
  "type": "module",
  "bin": { "trace2test": "./src/cli.js" },
  "scripts": {
    "test": "node --test",
    "lint": "node --check src/*.js && node --check examples/support-answer-bot/*.js && node --check examples/http-support-service/*.js",
    "demo:broken": "node examples/support-answer-bot/run.js --mode broken --assert",
    "demo:record": "node examples/support-answer-bot/run.js --mode broken --out .trace2test/demo/broken-traces.json",
    "demo:mine": "node src/cli.js mine --input .trace2test/demo/broken-traces.json --out .trace2test/demo/candidates.json",
    "demo:fix": "node examples/support-answer-bot/run.js --mode fixed --assert --out .trace2test/demo/fixed-traces.json",
    "demo:walkthrough": "node examples/support-answer-bot/walkthrough.js",
    "demo:http": "node examples/http-support-service/demo.js"
  },
  "keywords": ["llm", "evals", "regression-testing", "promptfoo", "langfuse", "observability"],
  "license": "MIT",
  "engines": { "node": ">=20" }
}
